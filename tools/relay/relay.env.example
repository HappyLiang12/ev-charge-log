# Copy to /etc/ev-relay/relay.env on the Pi: mode 600, owner root:evrelay.
# Never commit real camera credentials or the HMAC secret.
RTSP_URL=rtsp://CAMERA_USER:CAMERA_PASS@CAMERA_IP:554/stream1
# Leave API_URL empty to capture-only: frames queue locally until the Apps Script endpoint exists.
API_URL=
RELAY_HMAC_SECRET=replace-with-openssl-rand-hex-32
INTERVAL_SECONDS=300
# stream1 is 2560x1440 on the C520WS; 1920 keeps plates legible.
IMAGE_WIDTH=1920
QUEUE_DIR=/var/lib/ev-relay/queue
MAX_QUEUE=1000
